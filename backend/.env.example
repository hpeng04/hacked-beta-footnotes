# Copy to .env and fill in. Never commit .env.
# .env overrides variables already set in the shell or cloud environment; blank values are ignored.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BACKUP_PROVIDER=ollama
LLM_BACKUP_MODEL=gemma4:e2b
LLM_BACKUP_API_KEY=  # not needed for ollama
# Whisper model for uploads: base is fast enough for a live demo, small is more accurate but slower.
# Demo lectures are pre-processed with: python -m scripts.preprocess VIDEO ID --model small
WHISPER_MODEL=base
# Batched + greedy decoding for speed. Raise BATCH_SIZE if RAM allows; BEAM_SIZE=5 for accuracy.
WHISPER_BATCH_SIZE=8
WHISPER_BEAM_SIZE=1
