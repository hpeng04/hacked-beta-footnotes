# Copy to .env and fill in. Never commit .env.
# .env overrides variables already set in the shell or cloud environment; blank values are ignored.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BACKUP_PROVIDER=ollama
LLM_BACKUP_MODEL=gemma4:e2b
LLM_BACKUP_API_KEY=  # not needed for ollama
WHISPER_MODEL=small
